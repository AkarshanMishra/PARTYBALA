# PartyBala Production Security & Caching Headers (Cloudflare Pages / Netlify)

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Cache static assets (images, fonts, stylesheets, scripts) for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure HTML files are validated so user always sees newest releases
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
